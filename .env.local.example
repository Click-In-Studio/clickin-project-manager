# Copy this file to .env.local and fill in your Feishu app credentials.
# Register at https://open.feishu.cn and create an app to get these values.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must match the redirect URI registered in your Feishu app's OAuth settings.
FEISHU_REDIRECT_URI=http://127.0.0.1:3000/app/api/oath-callback

# ── Email（Resend）────────────────────────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret between the Cloudflare email-inbound Worker and this server.
# Generate with: openssl rand -hex 32
EMAIL_INBOUND_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
