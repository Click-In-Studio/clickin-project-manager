# Copy this file to .env.local and fill in your values.

# Canonical base URL for this deployment — no trailing slash.
# Used for absolute links in notification emails and RSVP buttons.
# Local: http://127.0.0.1:3000
BASE_PATH=https://backstage.example.com

# Feishu app credentials — register at https://open.feishu.cn
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email（Resend）────────────────────────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret between the Cloudflare email-inbound Worker and this server.
# Generate with: openssl rand -hex 32
EMAIL_INBOUND_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 注册邀请制（测试期）──────────────────────────────────────────────────────
# "1"/"true" = email 通道创建新账号需邀请正当性（注册邀请码 / registration_email
# 登记 / 定向项目邀请 / 邀请链接透传）。老用户登录不受影响。正式开放注册时移除。
REGISTRATION_INVITE_ONLY=1
